rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'admin@adel-tech.local';
    }


    function isAuthenticated() {
      return request.auth != null;
    }


    // محاضرات: أي حد يقرأ، الأدمن بس يكتب
    match /lessons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // امتحانات: الطلاب المسجلين يقرأوا، الأدمن يكتب
    match /exams/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // الطلاب: الأدمن كل شيء - الطالب يقرأ/يعدّل ملفه هو بس
    match /students/{studentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.phone + '@adel-tech.local' == request.auth.token.email);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.phone + '@adel-tech.local' == request.auth.token.email);
      allow delete: if isAdmin();
    }


    // الإجابات: الأدمن يقرأ كل شيء - الطالب يقرأ/يكتب إجاباته بس
    match /submissions/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.studentPhone + '@adel-tech.local' == request.auth.token.email);
      allow create: if isAuthenticated() &&
        request.resource.data.studentPhone + '@adel-tech.local' == request.auth.token.email;
      allow update, delete: if isAdmin();
    }


    // الواجبات: الطلاب المسجلين يقرأوا، الأدمن يكتب
    match /assignments/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ردود الواجبات: نفس سياسة الإجابات - الطالب ينشئ رده، الأدمن يقرأ/يصحيح
    match /assignment_submissions/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.studentPhone + '@adel-tech.local' == request.auth.token.email);
      allow create: if isAuthenticated() &&
        request.resource.data.studentPhone + '@adel-tech.local' == request.auth.token.email;
      allow update, delete: if isAdmin();
    }


    // التقدم في المحاضرات: أي مسجل يقرأ ويكتب
    match /progress/{id} {
      allow read, write: if isAuthenticated();
    }


    // أكواد التفعيل: الأدمن ينشئ - الطالب يقدر يستخدم كود غير مستخدم فقط
    match /access_codes/{codeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.grade == resource.data.grade &&
        request.resource.data.month == resource.data.month &&
        request.resource.data.durationDays == resource.data.durationDays &&
        request.resource.data.isUsed == true &&
        resource.data.isUsed == false
      );
    }


    // الإعدادات: عامة للقراءة، الأدمن فقط للكتابة
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // سجلات التفعيل: الأدمن فقط
    match /activation_logs/{id} {
      allow read, write: if isAdmin();
    }


    // ══════════════════════════════════════════════════════════
    // منتدى الأسئلة والنقاش (جديد)
    // ══════════════════════════════════════════════════════════
    // القراءة: أي مستخدم مصادق يقرأ، لكن التطبيق يعرض "المنشورة"
    // فقط في صفحة المنتدى، ويرى الطالب أسئلته المعلقة في "أسئلتي".
    // الكتابة: المستخدم العادي (الطالب) ينشئ فقط بحالة "قيد المراجعة"
    // ولا يستطيع النشر أو تغيير الحالة. المدرس (admin) يغيّر الحالة
    // (قبول/رفض/تثبيت) ويردّ بنفسه وينشر مباشرة.
    match /forum_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if (isAdmin() && request.resource.data.status in ['pending', 'published'] &&
        request.resource.data.title is string && request.resource.data.content.size() <= 2000) ||
        (isAuthenticated() && request.resource.data.status == 'pending' &&
        request.resource.data.authorStudentId is string &&
        request.resource.data.grade is string &&
        request.resource.data.title is string &&
        request.resource.data.content.size() <= 2000);
      allow update, delete: if isAdmin();
    }


    // ردود المنتدى: نفس سياسة المنشورات - الطالب يرد بقيد المراجعة،
    // والمدرس يردّ منشوراً مباشرة ويقبل/يرفض/يحذف ردود الطلاب.
    match /forum_replies/{replyId} {
      allow read: if isAuthenticated();
      allow create: if (isAdmin() && request.resource.data.status in ['pending', 'published'] &&
        request.resource.data.postId is string && request.resource.data.content.size() <= 1000) ||
        (isAuthenticated() && request.resource.data.status == 'pending' &&
        request.resource.data.postId is string &&
        request.resource.data.content.size() <= 1000);
      allow update, delete: if isAdmin();
    }


    // ==========================================================
    // ملاحظة: لحذف منشور، التطبيق يمسح ردوده أولاً ثم المنشور،
    // وبيزود/ينقص العداد replyCount على المنشور. كل دا يقع تحت
    // صلاحية isAdmin فقط (update)، فالعداد لا يمكن العبث به.
    // ==========================================================
  }
}