rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lesson HLS packages (encrypted segments + manifest). Public read is safe:
    // the segments are AES-128 encrypted and the playback goes through /api/hls/*
    match /lessons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Everything else (attachments, uploads) keeps working for authenticated users
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}