rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'admin@adel-tech.local';
    }

    // صور تسليمات الواجبات: الطالب (أي مستخدم مصادق) يرفع صوره،
    // الأدمن والطالب أنفسهم يقرأوا.
    match /submissions/{submissionId}/{fileName} {
      allow read: if isAdmin() || request.auth != null;
      allow write: if request.auth != null &&
        fileName.matches('.*\\.(jpg|jpeg|png|webp)$') &&
        request.resource.size < 5 * 1024 * 1024;
    }

    // أي مسار آخر: الأدمن فقط
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}